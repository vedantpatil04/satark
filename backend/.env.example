# ==============================================================================
# SATARK BACKEND ENVIRONMENT CONFIGURATION (Render / Local)
# ==============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=production

# Supabase Managed PostgreSQL (Transaction Pooler Mode on Port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase Cloud Authentication (JWKS & Admin)
SUPABASE_URL=https://ugsizlimcnxtbzkwficf.supabase.co
SUPABASE_JWKS_URL=https://ugsizlimcnxtbzkwficf.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=

# Application Secrets
SECRET_KEY=generate-a-secure-random-secret-key-here
AGENT_TOKEN_SECRET=generate-a-secure-random-device-secret-here
TEACHER_PROVISIONING_KEY=generate-a-secure-teacher-passkey-here
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cloudinary Evidence Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WebRTC STUN/TURN Signaling
WEBRTC_STUN_URLS=["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Frontend Origins
FRONTEND_URL=https://satark.vercel.app
CORS_ORIGINS=["https://*.vercel.app","http://localhost:5173"]

