# ==============================================================================
# SATARK BACKEND LOCAL LAN CONFIGURATION TEMPLATE
# ==============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=production

# Local Central SQLite Database (WAL Mode)
DATABASE_URL=sqlite:///./data/satark.db

# Application Secrets (Pure Local HS256 JWT)
SECRET_KEY=satark-local-secure-key-2026-production
AGENT_TOKEN_SECRET=satark-agent-device-secret-2026
TEACHER_PROVISIONING_KEY=TEACHER-SECURE-KEY-2026
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Local Evidence Storage
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins for Local LAN
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
