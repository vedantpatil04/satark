# ==============================================================================
# SATARK — SMART CLASSROOM PLATFORM ENVIRONMENT TEMPLATE
# Copy to .env and configure values. NEVER commit secrets to source control.
# ==============================================================================

# --- Frontend Configuration (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_SUPABASE_URL=https://ugsizlimcnxtbzkwficf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_MODE=development

# --- Backend Configuration (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Supabase Managed PostgreSQL Database URL (Transaction Pooler):
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./smart_classroom.db

# Supabase Auth Cloud Configuration
SUPABASE_URL=https://ugsizlimcnxtbzkwficf.supabase.co
SUPABASE_JWKS_URL=https://ugsizlimcnxtbzkwficf.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=

# Application & Device Agent Secrets
SECRET_KEY=dev-secret-key-change-in-production-smart-classroom-2026
AGENT_TOKEN_SECRET=dev-agent-secret-key-2026
TEACHER_PROVISIONING_KEY=TEACHER-SECURE-KEY-2026
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cloudinary Evidence Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WebRTC STUN/TURN Media Servers
WEBRTC_STUN_URLS=["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://*.vercel.app"]
