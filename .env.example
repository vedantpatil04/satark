# Smart Classroom Platform - Environment Configuration Template
# NOTE: Never commit production credentials or actual secret keys to source control.

# ==========================================
# Frontend Configuration (Vite)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_APP_MODE=development

# Optional Firebase / Third-Party Services (if activated in Phase 2)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==========================================
# Backend Configuration (FastAPI)
# ==========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./smart_classroom.db
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
ENVIRONMENT=development

# ==========================================
# Desktop Agent Configuration
# ==========================================
AGENT_BACKEND_URL=http://localhost:8000
AGENT_WS_URL=ws://localhost:8000/ws/agent
AGENT_HEARTBEAT_INTERVAL_SECONDS=5
AGENT_EVENT_BUFFER_SIZE=500

